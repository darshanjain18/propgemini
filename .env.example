APP_NAME="PropGemini"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=propgemini
DB_USER=root
DB_PASS=

# SMTP — Hostinger / custom mailbox
# Either MAIL_* or SMTP_* keys work (SMTP_* is used as fallback).
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=hr@propgemini.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hr@propgemini.com
MAIL_FROM_NAME="PropGemini Website"
MAIL_FROM_ENQUIRY=enquiry@propgemini.com
MAIL_FROM_CAREERS=hr@propgemini.com

# Form notification inboxes
MAIL_TO_ENQUIRY=enquiry@propgemini.com
MAIL_TO_CAREERS=hr@propgemini.com

# Meta WhatsApp Cloud API — primary lead alert channel
WHATSAPP_PROVIDER=meta
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
