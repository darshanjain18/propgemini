APP_NAME="PropGemini"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=propgemini
DB_USER=root
DB_PASS=

# SMTP — used to email lead alerts to the Contact email in Admin → Settings
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="PropGemini"

# Meta WhatsApp Cloud API — primary lead alert channel
# 1) Create a Meta app → WhatsApp product
# 2) Add a WhatsApp Business phone number
# 3) Copy Phone number ID + permanent access token here
# Alerts are sent TO the WhatsApp number saved in Admin → Settings
WHATSAPP_PROVIDER=meta
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
