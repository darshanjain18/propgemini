Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Keep real files and directories as-is.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Clean property URLs: /property/{slug}
    RewriteRule ^property/([^/]+)/?$ pages/property.php?id=$1 [L,QSA]

    # Clean news article URLs: /news/{slug}
    RewriteRule ^news/([^/]+)/?$ pages/news-article.php?slug=$1 [L,QSA]

    # Map /path to /path.php when that file exists.
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [L]

    # Map /path to /path/index.php when that directory index exists.
    RewriteCond %{REQUEST_FILENAME}/index.php -f
    RewriteRule ^(.+?)/?$ $1/index.php [L]
</IfModule>
